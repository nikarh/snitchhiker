---
// The Snitchhiker mark: an eye that watches every connection. Drawn in currentColor.
interface Props {
	size?: number;
	class?: string;
}
const { size = 24, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
	<path
		d="M16 7C9.5 7 4.6 11.4 2.5 16c2.1 4.6 7 9 13.5 9s11.4-4.4 13.5-9C27.4 11.4 22.5 7 16 7zm0 14.5a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"
		fill="currentColor"
	/>
	<circle cx="16" cy="16" r="2.4" fill="currentColor" />
</svg>
