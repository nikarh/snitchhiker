# Starts the desktop app with the graphical session, so prompts are answered from the start:
#   systemctl --user enable snitchhiker-ui
[Unit]
Description=Snitchhiker desktop app
Documentation=https://github.com/nikarh/snitchhiker
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/snitchhiker-ui
Restart=on-failure
RestartSec=5s
# A backstop against a leak, far above what the app uses.
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=graphical-session.target
