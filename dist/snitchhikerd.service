[Unit]
Description=Snitchhiker: interactive application firewall
Documentation=https://github.com/nikarh/snitchhiker
# The table is in place, and the daemon reports itself ready, before the network comes up: no new connection gets out
# undecided while it runs. When it stops, its tables go (fail = open, the default), or stay until it is back (fail =
# closed); a failed start, or a daemon that keeps crashing, never leaves them in the way.
Wants=network-pre.target
Before=network-pre.target
DefaultDependencies=no
After=local-fs.target
Before=shutdown.target
Conflicts=shutdown.target
# Keep trying for as long as it takes.
StartLimitIntervalSec=0

[Service]
Type=notify
# Settings are in /etc/snitchhiker/daemon.toml: change them there, then restart. SIGHUP reloads the rules.
ExecStart=/usr/bin/snitchhikerd
ExecReload=/bin/kill -HUP $MAINPID
# After every stop, whatever ended it (a crash, the OOM killer, SIGKILL): the tables go, or with fail = closed stay
# after a clean stop and a crash or two, but not when the daemon crashed 3 times in 5 minutes.
ExecStopPost=/usr/bin/snitchhikerd cleanup
Restart=on-failure
RestartSec=1s
# A backstop: the daemon stays far below this (under 50 MB with 10 000 rules and a million events); a leak is
# throttled, then restarted, rather than starving the machine.
MemoryHigh=256M
MemoryMax=384M
# Two malloc arenas rather than one per thread: memory one thread freed serves the others instead of staying resident.
Environment=MALLOC_ARENA_MAX=2
RuntimeDirectory=snitchhiker
RuntimeDirectoryMode=0755
StateDirectory=snitchhiker
StateDirectoryMode=0700

# Snitchhiker runs as root with only the capabilities it needs: managing the firewall (NET_ADMIN), loading and
# attaching its eBPF programs (BPF, PERFMON, SYS_RESOURCE for locked memory on older kernels), reading every
# process's /proc entries (SYS_PTRACE, DAC_READ_SEARCH), and giving the client socket to the client group (CHOWN).
# It writes only its state and runtime directories.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_CHOWN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# The system calls of a service, with the namespace ones (deciding inside containers' namespaces) and eBPF's. Any other
# fails with EPERM.
SystemCallFilter=@system-service @namespaces bpf perf_event_open
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
