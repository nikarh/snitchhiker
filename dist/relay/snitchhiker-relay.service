[Unit]
Description=Snitchhiker relay: where a user's nodes and devices meet behind NAT
Documentation=https://github.com/nikarh/snitchhiker
After=network-online.target
Wants=network-online.target

[Service]
# Settings are in /etc/snitchhiker/relay.toml.
ExecStart=/usr/bin/snitchhiker-relay --config /etc/snitchhiker/relay.toml
Restart=on-failure
RestartSec=2s
# A backstop against a leak: the relay needs a few tens of MB.
MemoryHigh=256M
MemoryMax=512M
DynamicUser=yes
# ACME's account and certificates.
StateDirectory=snitchhiker-relay
# Ports 80 and 443 without root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
